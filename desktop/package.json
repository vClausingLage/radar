{
  "name": "radar-game",
  "productName": "Radar Game",
  "version": "0.0.0",
  "private": true,
  "description": "A space-set simulation of an airborne radar",
  "author": "Vincent Clausing-Lage",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux"
  },
  "build": {
    "appId": "com.vclausinglage.radargame",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "game"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  }
}
